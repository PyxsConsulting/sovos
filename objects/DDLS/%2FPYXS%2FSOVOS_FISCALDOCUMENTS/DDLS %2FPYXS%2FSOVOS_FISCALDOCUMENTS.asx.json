   {
    "DDLNAME":"/PYXS/SOVOS_FISCALDOCUMENTS",
    "AS4LOCAL":"N",
    "AS4USER":"SAP_CUSTOMER",
    "AS4DATE":"0000-00-00",
    "AS4TIME":"00:00:00",
    "SOURCE":"@AccessControl.authorizationCheck: #NOT_REQUIRED\r\n@EndUserText.label: 'Documentos fiscais - SOVOS'\r\n\r\n@UI.presentationVariant: [{\r\n    sortOrder: [{\r\n        by: 'Timedate',\r\n        direction: #DESC\r\n    }],\r\n    visualizations: [{\r\n        type: #AS_LINEITEM\r\n    }]\r\n}]\r\n\r\ndefine root view entity /PYXS/SOVOS_FiscalDocuments\r\nas select from /pyxs/sov_nf_log\r\n{\r\n    @UI.lineItem: [{\r\n        type: #FOR_ACTION,\r\n        dataAction: 'SendIntegration',\r\n        label: 'Enviar Integração'\r\n    }]\r\n    // { type: #FOR_ACTION, dataAction: 'ExtractJson', label: 'Extrair JSON' }\r\n\r\n    @EndUserText.label: 'Data/Hora'\r\n    key timedate as Timedate,\r\n\r\n    @EndUserText.label: 'Documento'\r\n    key br_notafiscal as BrNotafiscal,\r\n\r\n    @EndUserText.label: 'ID'\r\n    key id as Id,\r\n\r\n    @EndUserText.label: 'Código de retorno'\r\n    returncode as Returncode,\r\n\r\n    @EndUserText.label: 'Descrição do retorno'\r\n    returnreason as Returnreason,\r\n\r\n    @EndUserText.label: 'Resposta'\r\n    @UI.hidden: true\r\n    response as Response,\r\n    \r\n    @UI.lineItem: [{ position: 20 }]\r\n    @UI.selectionField : [{position: 20}]\r\n\r\n    @EndUserText.label: 'Arquivo'\r\n    @Semantics.largeObject: {\r\n        fileName: 'Filename',\r\n        mimeType: 'Mimetype',\r\n        contentDispositionPreference: #ATTACHMENT\r\n    }\r\n    attachment as Attachment,\r\n\r\n    @EndUserText.label: 'Nome do arquivo'\r\n    @UI.hidden: true\r\n    concat(br_notafiscal, '.json') as Filename,\r\n\r\n    @EndUserText.label: 'Tipo MIME'\r\n    @Semantics.mimeType: true\r\n    @UI.hidden: true\r\n    cast('application/json' as abap.char(128)) as Mimetype\r\n}\r\n/*+[internal] {\n\"BASEINFO\":\n{\n\"FROM\":\n[\n\"/PYXS/SOV_NF_LOG\"\n],\n\"ASSOCIATED\":\n[],\n\"BASE\":\n[],\n\"ANNO_REF\":\n[],\n\"SCALAR_FUNCTION\":\n[],\n\"VERSION\":0,\n\"ANNOREF_EVALUATION_ERROR\":\"\"\n}\n}*/",
    "PARENTNAME":"",
    "ACTFLAG":"",
    "CHGFLAG":"",
    "SOURCE_TYPE":"W",
    "SOURCE_ORIGIN":"0",
    "ABAP_LANGUAGE_VERSION":"5"
   }
  ]
