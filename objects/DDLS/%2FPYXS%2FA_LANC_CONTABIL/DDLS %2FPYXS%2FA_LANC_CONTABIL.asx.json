    "SOURCE":"@EndUserText.label: 'entity para ação do fiori'\r\ndefine root abstract entity  /PYXS/A_LANC_CONTABIL \r\n{\r\n      @EndUserText.label     : 'Company'\r\n      @UI.selectionField     : [{position: 1}]\r\n      @Consumption.filter    : {mandatory: true, selectionType: #SINGLE}\r\n      @Consumption.valueHelpDefinition: [{ entity: {name: 'I_CompanyCode', element: 'CompanyCode'  }}]\r\n      @UI.lineItem           : [{ position: 1 }]\r\n  key CompanyCode            : abap.char(4);\r\n      @EndUserText.label: 'Local de Negócio'\r\n      @UI.selectionField: [{position: 2}]\r\n      @Consumption.valueHelpDefinition: [{\r\n      entity        : {name: 'I_BR_BusinessPlace', element: 'Branch'},\r\n      additionalBinding: [{\r\n        localElement: 'CompanyCode',\r\n        element     : 'CompanyCode',\r\n        usage       : #FILTER_AND_RESULT\r\n      }]\r\n      }]\r\n      @Consumption.filter: {mandatory: true, selectionType: #SINGLE}\r\n  key Branch        : abap.char(4);\r\n      @EndUserText.label     : 'Ledger'\r\n      @UI.selectionField     : [{position: 2}]\r\n      @Consumption.filter    : {mandatory: true, selectionType: #SINGLE}\r\n      @Consumption.valueHelpDefinition: [{ entity: {name: 'I_Ledger', element: 'Ledger'  }}]\r\n      @UI.lineItem           : [{ position: 2 }]\r\n  key Ledger                 : abap.char(2);\r\n      @EndUserText.label     : 'Fiscal year'\r\n      @UI.selectionField     : [{position: 3}]\r\n      @Consumption.filter    : {mandatory: true, selectionType: #INTERVAL}\r\n      @UI.lineItem           : [{ position: 3 }]\r\n  key FiscalYear             : abap.char(4);\r\n      @EndUserText.label     : 'Accounting Document'\r\n      @UI.selectionField     : [{position: 4}]\r\n      @Consumption.filter.selectionType: #INTERVAL\r\n      @UI.lineItem           : [{ position: 4 }]\r\n  key AccountingDocument     : abap.char(10);\r\n      @EndUserText.label     : 'Data Início'\r\n      @UI.selectionField     : [{position: 4}]