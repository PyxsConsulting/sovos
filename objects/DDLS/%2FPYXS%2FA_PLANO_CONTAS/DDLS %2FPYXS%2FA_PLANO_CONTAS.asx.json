    "SOURCE":"@EndUserText.label: 'entity para ação do fiori'\r\ndefine root abstract entity /PYXS/A_PLANO_CONTAS \r\n{\r\n      @EndUserText.label: 'Empresa'\r\n      @UI.selectionField: [{position: 1}]\r\n      @Consumption.filter:{mandatory: true, selectionType: #SINGLE}\r\n      @Consumption.valueHelpDefinition: [{ entity: {name: 'I_CompanyCode', element: 'CompanyCode'  }}]\r\n      @UI.lineItem      : [{ position: 1 }]\r\n  key CompanyCode       : abap.char(4);\r\n      @EndUserText.label: 'Local de Negócio'\r\n      @UI.selectionField: [{position: 2}]\r\n      @Consumption.valueHelpDefinition: [{\r\n      entity        : {name: 'I_BR_BusinessPlace', element: 'Branch'},\r\n      additionalBinding: [{\r\n        localElement: 'CompanyCode',\r\n        element     : 'CompanyCode',\r\n        usage       : #FILTER_AND_RESULT\r\n      }]\r\n      }]\r\n      @Consumption.filter: {mandatory: true, selectionType: #SINGLE}\r\n  key Branch        : abap.char(4);\r\n      @EndUserText.label: 'Hierarquia'\r\n      @UI.selectionField: [{position: 2}]\r\n      @Consumption.filter:{mandatory: true, selectionType: #SINGLE}\r\n      @Consumption.valueHelpDefinition: [{ entity: {name: 'I_GLAccountHierarchy', element: 'GLAccountHierarchy'  }}]\r\n      @UI.lineItem      : [{ position: 2 }]\r\n  key AccountHierarchy  : abap.char(4);\r\n      @EndUserText.label: 'Conta do Razão'\r\n      @UI.selectionField: [{position: 3}]\r\n      @Consumption.filter.selectionType: #INTERVAL\r\n      @Consumption.valueHelpDefinition: [{ entity: {name: 'I_GLAccount', element: 'GLAccount'  }}]\r\n      @UI.lineItem      : [{ position: 3 }]\r\n      GlAccount         : abap.char(10);\r\n      @EndUserText.label: 'Plano de Contas'\r\n      @UI.selectionField: [{position: 4}]\r\n      @UI.lineItem      : [{ position: 4 }]\r\n      ChartOfAccounts   : abap.char(4);\r\n      @EndUserText.label: 'Ignorar nível primário'\r\n      @UI.selectionField: [{position: 5}]\r\n      @UI.lineItem: [{position: 5}]\